# Django Configuration
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_DEBUG=False
DATABASE_ENGINE=sqlite # Set to 'postgres' to run inside docker-compose with postgres

# Postgres Database configuration (if engine is postgres)
POSTGRES_DB=applysense
POSTGRES_USER=applysense_user
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# AI Engines API Keys (Configure at least one)
OPENAI_API_KEY=your-openai-api-key-here
GROQ_API_KEY=your-groq-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# AI Default Priority Provider (openai, groq, openrouter, huggingface)
PRIMARY_AI_PROVIDER=openai