# Django Configuration
DJANGO_SECRET_KEY=replace_with_a_long_secure_random_string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.applysense.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.applysense.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://app.applysense.com

# Database Configuration
DATABASE_ENGINE=postgres
POSTGRES_DB=applysense
POSTGRES_USER=applysense_user
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_PORT=5432
CONN_MAX_AGE=60

# Redis & Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# LLM Keys
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
